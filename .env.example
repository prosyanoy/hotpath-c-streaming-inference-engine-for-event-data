# Copy to .env and adjust. Every variable has a safe local default; nothing here is a real secret.
# The binary reads the process environment, so use:  set -a; source .env; set +a; build/hotpath

# --- model ---
HOTPATH_MODEL=models/anomaly.onnx
# HOTPATH_MODEL_META=models/anomaly.meta      # defaults to <model>.meta

# --- ingest ---
HOTPATH_SOURCE=synthetic          # synthetic | tcp (newline-delimited "host_id,f0..f7")
HOTPATH_RATE=5000                 # synthetic events/sec, 0 = as fast as possible
HOTPATH_TOTAL_EVENTS=0            # 0 = run until SIGINT/SIGTERM
HOTPATH_ANOMALY_RATE=0.01
HOTPATH_SEED=42
HOTPATH_TCP_PORT=9200
HOTPATH_OVERFLOW=block            # block | drop (default: block for synthetic, drop for tcp)

# --- batching / inference ---
HOTPATH_BATCH_SIZE=256
HOTPATH_BATCH_TIMEOUT_US=2000
HOTPATH_WORKERS=2
HOTPATH_RING_CAPACITY=65536
HOTPATH_POOL_BATCHES=64

# --- Splunk HEC sink (plain http only) ---
HOTPATH_HEC_URL=http://127.0.0.1:8088/services/collector/event   # empty or "off" disables
HOTPATH_HEC_TOKEN=dev-token-not-secret
HOTPATH_HEC_BATCH=100
HOTPATH_HEC_FLUSH_MS=200

# --- observability ---
HOTPATH_METRICS_PORT=9100         # 0 disables /metrics
HOTPATH_METRICS_BIND=0.0.0.0
HOTPATH_PRINT_SUMMARY=1
